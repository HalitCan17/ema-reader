{
  "manifest_version": 3,
  "name": "EMA Reader",
  "version": "0.1.0",
  "description": "Seçili metni EMA Lightning (Türkçe, yapay zekâ sesi) ile yerel olarak sesli okur.",
  "permissions": ["storage", "offscreen"],
  "host_permissions": ["http://127.0.0.1/*"],
  "background": {
    "service_worker": "src/background/background.ts",
    "type": "module"
  },
  "action": {
    "default_popup": "src/popup/index.html",
    "default_title": "EMA Reader"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/content/content.ts"],
      "run_at": "document_idle"
    }
  ]
}
